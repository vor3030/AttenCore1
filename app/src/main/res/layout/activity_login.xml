<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Header Section with Gradient Background -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/header_background"
        android:padding="20dp"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Logo and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:id="@+id/appLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/atten_core"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/app_name" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/appName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title_part1"
                    android:textColor="#FFFFFF"
                    android:textSize="45sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_bold" />

                <TextView
                    android:id="@+id/appName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title_part2"
                    android:textColor="#4ECDC4"
                    android:textSize="45sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/roboto_bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Welcome Text -->
        <TextView
            android:id="@+id/welcomeHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/welcome_back"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/roboto_bold" />

        <TextView
            android:id="@+id/welcomeSubtext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sign_in_to_continue"
            android:textColor="#B0C4DE"
            android:textSize="20sp"
            android:fontFamily="@font/roboto_regular" />
    </LinearLayout>

    <!-- White Content Card - Scrollable -->
    <LinearLayout
        android:id="@+id/contentCard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/content_card_background"
        android:padding="24dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginTop="-60dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerSection">

            <!-- Email Section -->
            <TextView
                android:id="@+id/emailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/roboto_bold" />

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:autofillHints=""
                android:background="@drawable/input_field_background"
                android:hint="@string/enter_email"
                android:textColorHint="#999999"
                android:textColor="#333333"
                android:textSize="14sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:inputType="textEmailAddress"
                android:drawableStart="@drawable/ic_email"
                android:drawablePadding="12dp"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/roboto_regular" />

            <!-- Password Section -->
            <TextView
                android:id="@+id/passwordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/password"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/roboto_bold" />

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:autofillHints=""
                android:background="@drawable/input_field_background"
                android:hint="@string/enter_password"
                android:textColorHint="#999999"
                android:textColor="#333333"
                android:textSize="14sp"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:inputType="textPassword"
                android:drawableStart="@drawable/ic_lock"
                android:drawablePadding="12dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/roboto_regular" />

            <!-- Forgot Password -->
            <TextView
                android:id="@+id/forgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forgot_password"
                android:textColor="#4ECDC4"
                android:textSize="12sp"
                android:layout_gravity="end"
                android:layout_marginBottom="5dp"
                android:fontFamily="@font/roboto_regular" />

            <!-- Login Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/login"
                android:textColor="#4ECDC4"
                android:textSize="24sp"
                android:textStyle="bold"
                android:background="@drawable/login_button_background"
                android:layout_marginBottom="1dp"
                android:fontFamily="@font/roboto_bold"
                android:stateListAnimator="@null" />

            <!-- Divider with OR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="5dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="#4ECDC4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/or"
                    android:textColor="#999999"
                    android:textSize="12sp"
                    android:layout_marginLeft="12dp"
                    android:layout_marginRight="12dp"
                    android:fontFamily="@font/roboto_regular" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:background="#4ECDC4" />
            </LinearLayout>

            <!-- Social Login Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="200dp">

                <!-- Facebook -->
                <ImageButton
                    android:id="@+id/facebookButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_facebook"
                    android:background="@drawable/social_button_background"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/login" />

                <!-- Microsoft -->
                <ImageButton
                    android:id="@+id/microsoftButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_microsoft"
                    android:background="@drawable/social_button_background"
                    android:scaleType="centerInside"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@string/login" />

                <!-- Google -->
                <ImageButton
                    android:id="@+id/googleButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/social_button_background"
                    android:contentDescription="@string/login"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_google" />

                <!-- Apple -->
                <ImageButton
                    android:id="@+id/appleButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_apple"
                    android:background="@drawable/social_button_background"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/login" />
            </LinearLayout>
        </LinearLayout>

    <!-- Bottom Register Section -->
    <LinearLayout
        android:id="@+id/registerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/register_section_background"
        android:padding="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/don_t_have_an_account"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/roboto_regular" />

        <TextView
            android:id="@+id/registerLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register"
            android:textColor="#4ECDC4"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/roboto_bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>