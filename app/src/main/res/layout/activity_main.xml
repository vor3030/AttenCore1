<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_background">

    <!-- Centered Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="30dp"
        android:paddingRight="31dp">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/appIcon"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/atten_core"
            android:layout_marginBottom="2dp"
            android:contentDescription="@string/app_icon_description" />

        <!-- App Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"
            android:gravity="center">

            <TextView
                android:id="@+id/appTitle1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title_part1"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_bold" />

            <TextView
                android:id="@+id/appTitle2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title_part2"
                android:textColor="#4ECDC4"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="@font/roboto_bold" />
        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="#B0C4DE"
            android:textSize="16sp"
            android:layout_marginBottom="5dp"
            android:fontFamily="@font/roboto_regular" />

        <!-- Get Started Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/getStartedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/get_started"
            android:textColor="#1a5f6f"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/button_background"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/roboto_bold"
            android:stateListAnimator="@null" />

    </LinearLayout>
</LinearLayout>